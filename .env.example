# Copy to .env locally. Never put keys in tool arguments or commit them.
# Use API model IDs available to your accounts. Keys are shared by both profiles.
# The legacy MODEL/VISION variables below configure the quick profile.
COUNCIL_DEFAULT_PROFILE=quick
OPENAI_API_KEY=
COUNCIL_OPENAI_MODEL=
ANTHROPIC_API_KEY=
COUNCIL_CLAUDE_MODEL=
GEMINI_API_KEY=
COUNCIL_GEMINI_MODEL=
MISTRAL_API_KEY=
COUNCIL_MISTRAL_MODEL=

# Optional fifth member. Direct Meta standard tier; no Contributor fallback.
# Meta's dashboard calls this a Model API key. This app reads META_API_KEY.
META_API_KEY=
COUNCIL_META_MODEL=muse-spark-1.3
COUNCIL_DEEP_META_MODEL=muse-spark-1.3
COUNCIL_META_VISION=auto

# Image support: auto recognizes the exact tested models listed in src/images.js.
# For another API model, confirm its vision support before setting true. false disables it.
COUNCIL_OPENAI_VISION=auto
COUNCIL_CLAUDE_VISION=auto
COUNCIL_GEMINI_VISION=auto
COUNCIL_MISTRAL_VISION=auto

# Deep review profile: API IDs verified against provider documentation on 2026-09-18.
# Access/quota depends on your accounts. A blank model explicitly disables that member.
COUNCIL_DEEP_OPENAI_MODEL=gpt-6-astra
COUNCIL_DEEP_CLAUDE_MODEL=claude-opus-5
COUNCIL_DEEP_GEMINI_MODEL=gemini-3.1-pro-preview
COUNCIL_DEEP_MISTRAL_MODEL=mistral-medium-3-5
COUNCIL_DEEP_TIMEOUT_MS=180000
COUNCIL_DEEP_MAX_OUTPUT_TOKENS=16384
# COUNCIL_DEEP_OPENAI_VISION=auto
# COUNCIL_DEEP_CLAUDE_VISION=auto
# COUNCIL_DEEP_GEMINI_VISION=auto
# COUNCIL_DEEP_MISTRAL_VISION=auto

# Optional explicit quick overrides take precedence over legacy settings:
# COUNCIL_QUICK_OPENAI_MODEL=gpt-4.1-mini
# COUNCIL_QUICK_CLAUDE_MODEL=claude-haiku-4-5-20251001
# COUNCIL_QUICK_GEMINI_MODEL=gemini-3.5-flash-lite
# COUNCIL_QUICK_MISTRAL_MODEL=ministral-14b-latest
# COUNCIL_QUICK_TIMEOUT_MS=60000
# COUNCIL_QUICK_MAX_OUTPUT_TOKENS=4096
# COUNCIL_QUICK_<PROVIDER>_VISION=auto

# Defaults: real calls only when consult_council is called with dry_run=false.
COUNCIL_TIMEOUT_MS=60000
COUNCIL_MAX_OUTPUT_TOKENS=4096
COUNCIL_MAX_BRIEFING_CHARS=60000
# Optional absolute path. Default: .council next to this repository.
# COUNCIL_DATA_DIR=C:/path/to/private/council-records
